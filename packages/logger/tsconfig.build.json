{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2022", "DOM"],
		"strict": true,
		"declaration": true,
		"rootDir": "src",
		"outDir": "dist",
		"skipLibCheck": true,
		"verbatimModuleSyntax": true
	},
	"include": ["src"],
	"exclude": ["src/**/*.test.ts"]
}
