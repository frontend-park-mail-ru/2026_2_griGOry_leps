{
  "name": "goget-format",
  "version": "0.1.0",
  "description": "Russian formatters for prices, dates, ratings and plurals",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "prepublishOnly": "rm -rf dist && npm run build"
  },
  "keywords": [
    "format",
    "intl",
    "ru",
    "plural",
    "price"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frontend-park-mail-ru/2026_2_griGOry_leps.git",
    "directory": "packages/format"
  }
}
