{
  "name": "go-get-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "workspaces": [
    "packages/logger",
    "packages/debounce",
    "packages/format",
    "packages/validators",
    "packages/toast",
    "packages/forms",
    "packages/router",
    "packages/vdom"
  ],
  "scripts": {
    "build:packages": "tsc -b packages/tsconfig.build.json",
    "predev": "npm run build:packages",
    "dev": "vite",
    "build": "npm run build:packages && tsc && tsc -p packages/tsconfig.test.json && vite build",
    "preview": "vite preview",
    "typecheck": "npm run build:packages && tsc && tsc -p packages/tsconfig.test.json",
    "lint": "npm run build:packages && eslint .",
    "lint:fix": "eslint . --fix",
    "lint:css": "stylelint \"src/**/*.scss\"",
    "lint:css:fix": "stylelint \"src/**/*.scss\" --fix",
    "test": "npm run build:packages && vitest run",
    "start": "node server.js",
    "docs": "typedoc"
  },
  "browserslist": [
    "defaults"
  ],
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@eslint/js": "^9.13.0",
    "@rollup/plugin-babel": "^6.0.4",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.13.0",
    "globals": "^17.13.0",
    "jsdom": "^25.0.1",
    "sass-embedded": "^1.97.3",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typedoc": "^0.28.20",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^5.4.10",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "express": "^5.2.1",
    "goget-logger": "0.1.0",
    "goget-debounce": "0.1.0",
    "goget-format": "0.1.0",
    "goget-validators": "0.1.0",
    "goget-toast": "0.1.0",
    "goget-forms": "0.1.0",
    "goget-router": "0.1.0",
    "goget-vdom": "0.1.0"
  }
}
