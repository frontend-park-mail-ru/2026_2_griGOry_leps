<a class="promo-card" href="{{link}}" data-link>
    <div class="promo-card__text">
        <h3 class="promo-card__title">{{title}}</h3>
        <p class="promo-card__subtitle">{{subtitle}}</p>
    </div>
    <img src="{{image}}" alt="{{title}}" loading="lazy" onerror="this.remove()" class="promo-card__img">
</a>