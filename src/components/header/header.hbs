<header class="header">
    <div class="header__inner">

        <a href="/" data-link class="header__logo" aria-label="GoGet — на главную">
            <img src="/img/goget.svg" alt="GoGet">
        </a>

        <a href="/categories" data-link class="header__category">
            Все категории
        </a>

        <button type="button" class="header__city">
            <img src="/img/pin.svg" alt="" class="header__icon" aria-hidden="true">
            <span>Москва</span>
            <img src="/img/chevron-down.svg" alt="" class="header__chevron" aria-hidden="true">
        </button>

        <form class="header__search search" action="/search" method="get" role="search">
            <input type="text" name="q" placeholder="Поиск по объявлениям" autocomplete="off" class="search__input">
            <button type="submit" class="search__btn" aria-label="Найти">
                <img src="/img/search_icon.svg" alt="" class="search__icon" aria-hidden="true">
            </button>
        </form>

        {{#if isAuthenticated}}
            <button type="button" class="header__post" disabled>Разместить объявление</button>
            <div class="header__user">
                <button type="button" class="header__user-toggle" data-action="toggle-user-menu" aria-label="{{userName}}" aria-haspopup="true">
                    <span class="header__avatar">{{userInitial}}</span>
                    <img src="/img/chevron-down.svg" alt="" class="header__chevron" aria-hidden="true">
                </button>
                <div class="header__menu">
                    <span class="header__menu-name">{{userName}}</span>
                    <button type="button" class="header__menu-item" data-action="logout">Выйти</button>
                </div>
            </div>
        {{else}}
            <a href="/register.html" data-link class="header__signup">Зарегистрироваться</a>
            <a href="/login.html"    data-link class="header__login">Войти</a>
        {{/if}}

    </div>
</header>
