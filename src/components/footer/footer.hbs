<footer class="footer">
    <div class="footer__top">
        <div class="footer__brand">
            <a href="/" data-link class="footer__logo">
                <img src="/img/goget-mono.svg" alt="GoGET" width="89" height="40">
            </a>
            <p class="footer__tagline">Покупайте и продавайте рядом с домом — быстро и без посредников</p>
        </div>

        <nav class="footer__cols" aria-label="Меню в подвале">
            <div class="footer__col">
                <h4 class="footer__heading">Покупателям</h4>
                <span class="footer__link footer__link--disabled" aria-disabled="true">Как купить</span>
                <span class="footer__link footer__link--disabled" aria-disabled="true">Безопасная сделка</span>
                <span class="footer__link footer__link--disabled" aria-disabled="true">Доставка</span>
                <span class="footer__link footer__link--disabled" aria-disabled="true">Избранное</span>
            </div>
            <div class="footer__col">
                <h4 class="footer__heading">Продавцам</h4>
                <span class="footer__link footer__link--disabled" aria-disabled="true">Разместить объявление</span>
                <span class="footer__link footer__link--disabled" aria-disabled="true">Правила размещения</span>
                <span class="footer__link footer__link--disabled" aria-disabled="true">Продвижение</span>
            </div>
            <div class="footer__col">
                <h4 class="footer__heading">GoGET</h4>
                <span class="footer__link footer__link--disabled" aria-disabled="true">О проекте</span>
                <span class="footer__link footer__link--disabled" aria-disabled="true">Помощь</span>
                <span class="footer__link footer__link--disabled" aria-disabled="true">Контакты</span>
            </div>
        </nav>
    </div>

    <div class="footer__bottom">
        <span>© {{year}} GoGET</span>
        <span class="footer__legal">
            <span class="footer__link footer__link--small footer__link--disabled" aria-disabled="true">Политика конфиденциальности</span>
            <a href="/terms" data-link class="footer__link footer__link--small">Условия использования</a>
        </span>
    </div>
</footer>
