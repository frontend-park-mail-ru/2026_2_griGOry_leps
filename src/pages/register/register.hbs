<div class="auth-page">
    <header class="auth-header">
        <a class="auth-header__logo" href="/" data-link aria-label="GoGet — на главную">
            <img src="/src/img/goget.png" alt="GoGet" class="auth-header__logo-img" onerror="this.remove()">
        </a>
        <a class="auth-header__back" href="/" data-link>← Вернуться на главную</a>
    </header>

    <main class="auth-page__content">
        <section class="auth-card">
            <header class="auth-card__heading">
                <h1 class="auth-card__title">Регистрация в GoGET</h1>
                <p class="auth-card__subtitle">Создайте аккаунт — это займёт меньше минуты</p>
            </header>

            {{{tabsHtml}}}

            <form class="auth-form" id="register-form" novalidate>
                <div class="auth-form__fields">{{{fieldsHtml}}}</div>

                <button type="submit" class="btn btn-primary btn-block">Зарегистрироваться</button>

                <p class="form-note">
                    Нажимая «Зарегистрироваться», вы соглашаетесь с
                    <a href="/terms" class="link link--strong">условиями использования</a>
                </p>
            </form>
        </section>
    </main>
</div>
