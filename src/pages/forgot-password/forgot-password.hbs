{{#> auth-layout}}
  {{#> auth-card title="Восстановление пароля" subtitle="Укажите email, который использовали при регистрации — пришлём код для сброса пароля"}}
    {{#> auth-form id="forgot-form"}}
      <div class="auth-form__fields">
        {{> form-field id="email-input" name="email" label="Email" type="email" placeholder="name@mail.ru" autocomplete="email"}}
      </div>
      {{> button text="Отправить код" type="submit" block=true}}
      {{#> form-note dark=true}}Вспомнили пароль? {{> link href="/login" text="Войти" spa=true}}{{/form-note}}
    {{/auth-form}}
  {{/auth-card}}
{{/auth-layout}}
