<div class="auth-page">
    <header class="auth-header">
        <a class="auth-header__logo" href="/" data-link aria-label="GoGet — на главную">
            <img src="/src/img/goget.png" alt="GoGet" class="auth-header__logo-img" onerror="this.remove()">
        </a>
        <a class="auth-header__back" href="/" data-link>← Вернуться на главную</a>
    </header>

    <main class="auth-page__content">
        <section class="auth-card">
            <header class="auth-card__heading">
                <h1 class="auth-card__title">Придумайте новый пароль</h1>
                <p class="auth-card__subtitle">Мы отправили код на {{email}}</p>
            </header>

            <form class="auth-form" id="reset-form" novalidate>
                <div class="auth-form__fields">{{{fieldsHtml}}}</div>

                <button type="submit" class="btn btn-primary btn-block">Сохранить пароль</button>

                <p class="form-note form-note--dark">
                    Код не пришёл?
                    <button type="button" class="link link--button">Отправить ещё раз через 0:59</button>
                </p>
            </form>
        </section>
    </main>
</div>
